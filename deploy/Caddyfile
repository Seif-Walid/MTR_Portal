# Terminates HTTPS for the public hostnames and hands everything to the
# frontend nginx containers, which serve the SPA and reverse-proxy /api/ to
# their own backend on the same origin.
#
# With a bare hostname (no scheme) Caddy automatically provisions and renews a
# Let's Encrypt certificate for it and redirects HTTP -> HTTPS. Both records
# must stay DNS-only (grey cloud) in Cloudflare.
#
# Upstreams are addressed by CONTAINER name, not service name: Caddy sits on
# both the production network and the shared `portal-edge` network, where the
# staging stack's frontend service is also called "frontend".

# Production — SITE_ADDRESS = portal.mindtechrobotics.com
{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy portal-frontend:80
}

# Staging — separate stack (docker-compose.staging.yml). Returns 502 while
# that stack is down; production is unaffected.
{$STAGING_ADDRESS:staging.portal.mindtechrobotics.com} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy portal-staging-frontend:80
}
