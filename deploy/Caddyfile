# Terminates HTTPS for the public hostname and hands everything to the
# existing frontend nginx container, which already serves the SPA and
# reverse-proxies /api/ to the backend on the same origin.
#
# SITE_ADDRESS is injected from the environment (e.g. mtrportal.duckdns.org).
# With a bare hostname (no scheme) Caddy automatically provisions and renews
# a Let's Encrypt certificate and redirects HTTP -> HTTPS.
{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy frontend:80
}
